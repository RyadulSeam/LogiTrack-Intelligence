{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "t09_vtype",
  "displayName": "Tooltip: Vehicle Type",
  "displayOption": "ActualSize",
  "height": 300,
  "width": 400,
  "pageBinding": {
    "name": "bind_t09_vtype",
