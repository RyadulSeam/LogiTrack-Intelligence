              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#EAF0FF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111B34"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1A2748"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#22304F"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
