{
  "name": "LogiTrack Midnight Premium",
  "dataColors": [
    "#22D3EE",
    "#6C7BFF",
    "#F5B942",
    "#34D399",
    "#B58CFF",
    "#FB923C",
    "#FB7185",
    "#4DA3FF",
    "#2DD4BF",
    "#F472B6"
  ],
  "background": "#111B34",
  "foreground": "#EAF0FF",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#F5B942",
  "bad": "#FB7185",
  "maximum": "#22D3EE",
  "center": "#F5B942",
  "minimum": "#6C7BFF",
  "firstLevelElements": "#EAF0FF",
  "secondLevelElements": "#9DB0D3",
  "thirdLevelElements": "#22304F",
  "fourthLevelElements": "#6B7FA6",
  "secondaryBackground": "#1A2748",
  "tertiaryBackground": "#22304F",
  "hyperlink": "#22D3EE",
  "visitedHyperlink": "#B58CFF",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#EAF0FF"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#EAF0FF"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#EAF0FF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#9DB0D3"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "general": [
          {
            "responsive": true
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#EAF0FF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#9DB0D3"
              }
            },
            "background": {
              "solid": {
                "color": "#111B34"
              }
            },
            "border": {
              "solid": {
                "color": "#22304F"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "type": "Default",
            "titleFontColor": {
              "solid": {
                "color": "#EAF0FF"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "background": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B1120"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#EAF0FF"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#9DB0D3"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#EAF0FF"
              }
            },
            "fontSize": 18,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#9DB0D3"
              }
            },
            "fontSize": 10
          }
