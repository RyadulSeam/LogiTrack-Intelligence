{
  "name": "LogiTrack Intelligence Corporate Theme",
  "dataColors": [
    "#2F5D8A",
    "#64748B",
    "#142B45",
    "#2E7D5B",
    "#C58B2A",
    "#C65353",
    "#8793A1",
    "#4A709C"
  ],
  "background": "#F4F6F8",
  "foreground": "#142B45",
  "tableAccent": "#2F5D8A",
  "good": "#2E7D5B",
  "neutral": "#C58B2A",
  "bad": "#C65353",
  "maximum": "#2E7D5B",
  "center": "#C58B2A",
  "minimum": "#C65353",
  "null": "#8793A1",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 24,
      "color": "#142B45"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#142B45"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#142B45"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#142B45" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F6F8" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#142B45" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#142B45" } },
            "textSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#142B45" } },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#142B45" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#142B45" } },
            "fontColorSecondary": { "solid": { "color": "#142B45" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#E2E8F0" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#142B45" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#142B45" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ]
      }
    }
  }
}
